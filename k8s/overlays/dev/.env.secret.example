# Copia in `.env.secret` (gitignored, in questa stessa cartella). Stesse
# credenziali del file alla radice del repo per convenzione (comodo, non
# obbligatorio): l'app in dev/docker-compose e questo overlay k8s dev sono
# comunque due file distinti — Kustomize non legge secretGenerator fuori
# dalla propria directory.
POSTGRES_USER=price_service
POSTGRES_PASSWORD=price_service_dev_password
POSTGRES_DB=price_service
