# Template per le credenziali locali del DB.
#
# Copia questo file in `.env.secret` (gitignored) per personalizzare le
# credenziali in locale. Senza `.env.secret`, sia l'app (src/price_service/config.py)
# sia `docker-compose.yml` usano già gli stessi default di sviluppo qui sotto —
# nessun setup obbligatorio per far girare il prototipo.
#
# Lo stesso file alimenterà anche il `secretGenerator` di Kustomize per i
# manifest k8s (Fase 6): solo queste tre credenziali devono coincidere tra
# eventuali applicazioni consumer diverse (es. un futuro batch), non l'host.
POSTGRES_USER=price_service
POSTGRES_PASSWORD=price_service_dev_password
POSTGRES_DB=price_service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
